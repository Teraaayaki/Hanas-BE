export const getTransactions = async (req, res) => {
  const transactions = await Booking.aggregate([
    { $match: { book_status: "Finished" } },
    {
      $lookup: {
        from: "users",
        localField: "client",
        foreignField: "_id",
        as: "clientData",
      },
    },
    {
      $lookup: {
        from: "users",
        localField: "worker",
        foreignField: "_id",
        as: "workerData",
      },
    },
  ]);

  return res.status(200).json({ transactions });
};

